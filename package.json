{
	"name": "portfolio",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
		"check-types": "turbo run check-types",
		"prepare": "husky"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"prettier": "^3.7.4",
		"turbo": "^2.9.16",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=18"
	}
}
